# PostgreSQL Analytical Stack Configuration
# Copia este archivo a .env y ajusta los valores según tu entorno local o Docker

ANALYTICS_PG_HOST_PORT=5433
ANALYTICS_PG_USER=etl_user
ANALYTICS_PG_PASSWORD=etl_password

# Opcional (valores por defecto dentro de Docker)
# ANALYTICS_PG_HOST=analytics-postgres
# ANALYTICS_PG_PORT=5432
